# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Runtime data — never commit real credentials or databases
settings.json
*.db
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.wal
*.wal
.env
.anaplan_audit/

# Parity-test scratch data (real tenant backups copied in for Phase 4 validation)
scratch/

# Test / coverage artefacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store

# LibreOffice / Office lock files (created when a CSV is open in a viewer)
.~lock.*#

# IDEs
.vscode/
.idea/
*.swp

# Claude Code session metadata
.claude/

# Runtime logs and run-lock
logs/
*.lock
# ...but the dependency lock IS committed (reproducible installs).
!uv.lock

# Internal session notes (not for public repo)
session-notes.md
doc-updates.md
doc-updates-v3.md

# Local run outputs — contain REAL tenant data (user emails, workspace/model
# IDs, audit events). NEVER publish, especially to a public repo.
samples/
latest-run-log.txt
*_backup_*.db

# Markdown is local build context for Claude Code, not shipped to customers.
# Only the root README.md is published. (Excludes CLAUDE.md, the spec/handoff
# docs, docs/*.md, CONTRIBUTING.md, SECURITY.md, scratch findings, etc.)
*.md
!README.md

# The docs/ directory is ignored by default (drafts, stale v3 changelogs,
# community/ scratch), but the four v4 customer docs are published — both the
# Markdown sources and the generated .docx. Add a pair here when a doc joins
# the set; regenerate the .docx with `make docs`.
docs/*
docs/community/
!docs/technical-reference.md
!docs/technical-reference.docx
!docs/operations-runbook.md
!docs/operations-runbook.docx
!docs/anaplan-model-setup-guide.md
!docs/anaplan-model-setup-guide.docx
!docs/developer-guide.md
!docs/developer-guide.docx
